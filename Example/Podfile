platform :ios, '15.0'

target 'Last.fm' do
  pod 'LastFm', :path => '../LastFm.podspec'
  pod 'SDWebImage'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # AFNetworking 4.0.1 directly imports the private header <netinet6/in6.h>,
  # which recent SDKs reject. <netinet/in.h> (imported on the line above) already
  # pulls in the IPv6 types, so the direct include is redundant — strip it.
  %w[AFHTTPSessionManager.m AFNetworkReachabilityManager.m].each do |name|
    path = File.join(installer.sandbox.root, 'AFNetworking', 'AFNetworking', name)
    next unless File.exist?(path)
    contents = File.read(path)
    patched = contents.gsub(/^#import <netinet6\/in6\.h>\n/, '')
    next if patched == contents
    File.chmod(0644, path)
    File.write(path, patched)
  end
end
